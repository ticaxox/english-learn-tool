APP_ENV=development
APP_NAME=AI English Learning Tool
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
APP_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+asyncpg://english_learn:english_learn@localhost:5432/english_learn
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-characters
SECRET_ENCRYPTION_KEY=replace-with-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
