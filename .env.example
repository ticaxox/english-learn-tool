# Local/CI defaults only. Replace every placeholder before any non-test deployment.
COMPOSE_PROJECT_NAME=english-learn
EDGE_BIND_ADDRESS=127.0.0.1
EDGE_PORT=8080

GHCR_OWNER=replace_with_github_owner
IMAGE_TAG=local
API_IMAGE=english-learn-api:local
FRONTEND_IMAGE=english-learn-frontend:local
REVERSE_PROXY_IMAGE=english-learn-reverse-proxy:local

APP_ENV=production
# Quote values containing spaces; deployment scripts source this file in Bash.
APP_NAME="AI English Learning Tool"
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:8080

POSTGRES_DB=english_learn
POSTGRES_USER=english_learn
POSTGRES_PASSWORD=replace_with_local_postgres_password
DATABASE_URL=postgresql+asyncpg://english_learn:replace_with_local_postgres_password@postgres:5432/english_learn
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace_with_a_unique_32_character_jwt_secret
REFRESH_TOKEN_PEPPER=replace_with_a_unique_32_character_pepper
SECRET_ENCRYPTION_KEY=replace_with_a_unique_32_character_key

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Optional absolute or repo-relative backup directory used by deploy/scripts/deploy.sh.
BACKUP_DIR=deploy/backups
